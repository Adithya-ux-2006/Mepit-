# Server-only Supabase configuration. Never expose the service-role key.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Generate a dedicated random value of at least 32 bytes.
RATE_LIMIT_SECRET=

# Security controls.
ALLOW_PUBLIC_SIGNUP=false
REQUIRE_ADMIN_MFA=true
TRUST_PROXY_HEADERS=false

